{
  "name": "notionsi",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:exe": "node scripts/build-executable.js",
    "test:exe": "node scripts/smoke-executable.js",
    "start": "node index.js",
    "attach": "node index.js attach",
    "config": "node index.js config",
    "config:show": "node index.js config --show --attach",
    "tui": "node index.js tui",
    "check": "node index.js check",
    "start:zhipu": "node index.js start --provider zhipu",
    "start:coding-cn": "node index.js start --provider zhipu --profile coding-cn",
    "attach:coding-cn": "node index.js attach --provider zhipu --profile coding-cn",
    "check:coding-cn": "node index.js check --provider zhipu --profile coding-cn",
    "attach:zhipu": "node index.js attach --provider zhipu",
    "start:mock": "node index.js start --provider mock",
    "check:zhipu": "node index.js check --provider zhipu",
    "test": "node --test test/*.test.js",
    "verify": "node index.js verify",
    "verify:editor": "node index.js verify-editor"
  },
  "dependencies": {
    "marked": "15.0.12"
  },
  "description": "Route Notion desktop AI requests to configurable model providers.",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6"
  }
}
