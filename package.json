{
  "name": "notion-ai-mock-router",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "attach": "node src/cli.mjs --attach",
    "start:zhipu": "node src/cli.mjs --provider zhipu",
    "start:coding-cn": "node src/cli.mjs --provider zhipu --profile coding-cn",
    "attach:coding-cn": "node src/cli.mjs --attach --provider zhipu --profile coding-cn",
    "check:coding-cn": "node scripts/check-zhipu.mjs --profile coding-cn",
    "attach:zhipu": "node src/cli.mjs --attach --provider zhipu",
    "start:mock": "node src/cli.mjs --provider mock",
    "config": "node src/cli.mjs --check-config",
    "check:zhipu": "node scripts/check-zhipu.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "node scripts/verify-live.mjs",
    "verify:editor": "node scripts/verify-editor.mjs"
  },
  "dependencies": {
    "marked": "15.0.12"
  }
}
