# Preferred setup: npm run config
# Saves provider/model/keys to %LOCALAPPDATA%/NotionSI/config.json on Windows.
# This file remains a legacy fallback: CLI > process env > user config > .env.local.
# Select the CN endpoint explicitly. Use the matching product's API Key.
NOTIONSI_PROVIDER=zhipu
ZHIPU_API_PROFILE=coding-cn
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-5.3
ZHIPU_MAX_TOKENS=2048
ZHIPU_TIMEOUT_MS=180000
ZHIPU_THINKING=enabled
ZHIPU_REASONING_EFFORT=low

# Other providers: set NOTIONSI_PROVIDER and uncomment the matching settings.
# Each *_BASE_URL is an API root, not the full /chat/completions URL.
# OpenAI API (separate API billing; uses Responses).
# NOTIONSI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1

# ChatGPT subscription via Codex (no OPENAI_API_KEY).
# Run: node index.js login --provider openai-codex
# NOTIONSI_PROVIDER=openai-codex
# OPENAI_CODEX_MODEL=gpt-5.2-codex
# Default: %LOCALAPPDATA%/NotionSI/auth/openai-codex/auth.json
# Explicit paths must be fully expanded:
# OPENAI_CODEX_AUTH_FILE=C:/Users/YourName/AppData/Local/NotionSI/auth/openai-codex/auth.json
# OPENAI_CODEX_CLI=C:/path/to/codex.exe
# OPENAI_CODEX_REASONING_EFFORT=medium

# NOTIONSI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# NOTIONSI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# NOTIONSI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# NOTIONSI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=provider/model-id

# NOTIONSI_PROVIDER=moonshot
# MOONSHOT_API_KEY=
# MOONSHOT_MODEL=kimi-k2.5

# NOTIONSI_PROVIDER=qwen
# QWEN_API_KEY=
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# NOTIONSI_PROVIDER=minimax
# MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-M2.5

# NOTIONSI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=your-model-id

# NOTIONSI_PROVIDER=mistral
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Local Ollama: requires a pulled model with tool support when native tools are on.
# NOTIONSI_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Custom Chat Completions server / LM Studio / vLLM (key optional).
# NOTIONSI_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_COMPATIBLE_MODEL=your-model-id
# OPENAI_COMPATIBLE_API_KEY=

# New HTTP providers also accept <PREFIX>_MAX_TOKENS (default 4096) and
# <PREFIX>_TIMEOUT_MS (default 180000). The HTTP providers accept
# <PREFIX>_REASONING_EFFORT when the selected model supports that parameter.
# Anthropic/Gemini additionally accept <PREFIX>_THINKING_BUDGET (exclusive with effort).

# Optional override for the built-in full Notion reference prompt.
# Loaded once at startup, relative to working directory. Leave empty for built-in.
# NOTIONSI_SYSTEM_PROMPT_FILE=system-prompt.local.txt

# Native session tools (requires the Notion page router).
NOTIONSI_TOOLS=off

# Stream assistant replies to this terminal (0 = status only).
NOTIONSI_LOG_CONTENT=1

# Optional Notion executable OR installation directory (Windows).
# Priority: --notion > process environment > .env.local > auto-detection.
# Use an actual path; %LOCALAPPDATA% and ~ are not expanded.
# NOTION_PATH="C:/Users/YourName/AppData/Local/Programs/Notion/Notion.exe"
